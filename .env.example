# Copy to .env and replace placeholders. Never commit .env.
# `canvas-planner` loads .env from the current directory.

# --- Required: model provider (OpenAI-compatible chat completions) ---
LLM_API_KEY=replace-with-your-model-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
# Optional sampling/timeouts.
# LLM_TEMPERATURE=0.2
# LLM_TIMEOUT_SECS=60

# --- Required: the student's IANA time zone ---
# Canvas dates are shown by canvas-mcp in CANVAS_TIMEZONE. Set both to the same
# zone or the agent will fail closed rather than misread a deadline.
STUDENT_TIMEZONE=America/Chicago

# --- Required: how to launch the existing canvas-mcp stdio server ---
# Use an absolute path if `canvas-mcp` is not on PATH.
CANVAS_MCP_COMMAND=canvas-mcp
# Whitespace-separated extra arguments. Example:
# CANVAS_MCP_ARGS=--env-file /absolute/path/to/canvas-mcp.env
CANVAS_MCP_ARGS=

# --- Optional: deterministic clock override (ISO 8601 with offset, or YYYY-MM-DD) ---
# Example for reproducible transcripts: 2026-11-12T09:25:00-06:00
CANVAS_AGENT_NOW=

# --- Optional application settings ---
CANVAS_AGENT_AUDIT_LOG=logs/audit.jsonl
CANVAS_AGENT_POLICY=config/policy.toml
CANVAS_AGENT_HORIZON_DAYS=7
CANVAS_AGENT_MAX_STEPS=6
# CANVAS_AGENT_MAX_TOOL_CALLS=12

# Canvas credentials are owned by canvas-mcp. Either configure canvas-mcp's own
# ~/.config/canvas-mcp/.env, or export CANVAS_API_TOKEN here; the MCP child process
# inherits this environment. Never commit real credentials.
# CANVAS_API_TOKEN=
